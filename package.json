{
  "name": "ai-command-center",
  "productName": "AI Command Center",
  "version": "0.7.0",
  "description": "Centro de mando local para IAs, agentes y proyectos (Windows, macOS y Linux)",
  "author": "Hredo",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "desktopName": "ai-command-center.desktop",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "pack": "node scripts/check-native.cjs && electron-vite build && electron-builder --dir",
    "dist": "node scripts/check-native.cjs && electron-vite build && electron-builder",
    "dist:win": "node scripts/check-native.cjs && electron-vite build && electron-builder --win nsis zip",
    "dist:zip": "node scripts/check-native.cjs && electron-vite build && electron-builder --win zip",
    "dist:mac": "node scripts/check-native.cjs && electron-vite build && electron-builder --mac dmg",
    "dist:linux": "node scripts/check-native.cjs && electron-vite build && electron-builder --linux deb AppImage",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "0.14.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.0",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.43.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.0.0",
    "vite": "^8.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@homebridge/node-pty-prebuilt-multiarch",
      "electron",
      "esbuild"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hredo/ai-command-center.git"
  },
  "homepage": "https://github.com/Hredo/ai-command-center",
  "bugs": {
    "url": "https://github.com/Hredo/ai-command-center/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
